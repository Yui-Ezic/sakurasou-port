{"by": "opus", "k": "19361bd671877c6e", "note": "", "ru": "Спасибо большое.", "st": "draft"}
{"by": "opus", "k": "67242096f9fc85ef", "note": "", "ru": "Держи, кофе.", "st": "draft"}
