{"by": "opus", "k": "6699f5b172c7b843", "note": "", "ru": "Это первый 2D-фон города, да?", "st": "draft"}
{"by": "opus", "k": "f6ea127f5cf8741f", "note": "", "ru": "Да. Хорошо получилось?", "st": "draft"}
{"by": "opus", "k": "1c3a89823a962f61", "note": "", "ru": "Ну…", "st": "draft"}
{"by": "opus", "k": "3939c6d43ec7e893", "note": "", "ru": "Хм-м…", "st": "draft"}
