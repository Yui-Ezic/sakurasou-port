{"by": "opus", "k": "a57783baaacb5411", "note": "", "ru": "идут отдельно от нас.", "st": "draft"}
{"by": "opus", "k": "93fe693d28cb02e1", "note": "", "ru": "Возвращайтесь самостоятельно.", "st": "draft"}
{"by": "opus", "k": "fbd5f3292368ab0f", "note": "", "ru": "Э… В смысле?", "st": "draft"}
